# Private project environment; no production values.

# Required deployment addresses for the public source configuration.
HOMELAB_AUTOMATION_HOMEASSISTANT_DNS_1=
HOMELAB_AUTOMATION_HOMEASSISTANT_DNS_2=
HOMELAB_AUTOMATION_HOMEASSISTANT_IPV4_ADDRESS_1=
HOMELAB_AUTOMATION_MOSQUITTO_IPV4_ADDRESS_1=
HOMELAB_AUTOMATION_NODE_RED_IPV4_ADDRESS_1=
HOMELAB_AUTOMATION_ZIGBEELENS_IPV4_ADDRESS_1=
HOMELAB_AUTOMATION_ZIGBEELENS_IPV4_ADDRESS_2=

# Split source roots and private assembled inputs. Example paths only.
HOMELAB_AUTOMATION_ROOT=/srv/source/homelab-automation
HOMELAB_HA_CONFIG_DIR=/srv/private/runtime/ha_config_dir
HOMELAB_MQTT_CONFIG_DIR=/srv/private/runtime/mqtt_config_dir
HOMELAB_MQTT_EXPLORER_CONFIG_DIR=/srv/private/runtime/mqtt_explorer_config_dir
HOMELAB_NODE_RED_CONFIG_DIR=/srv/private/runtime/node_red_config_dir
HOMELAB_ZIGBEELENS_CONFIG_FILE=/srv/private/runtime/zigbeelens_config_file
